# development | staging | production
ENVIRONMENT=production
PORT=8000

# Postgres connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/alldriveph
DB_POOL_SIZE=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=adp_session

# Comma separated
CORS_ORIGINS=https://alldriveph.com,https://www.alldriveph.com
ALLOWED_HOSTS=api.alldriveph.com,localhost
# true behind a reverse proxy, so rate limits see the real client IP
TRUST_PROXY=false

# Rate limits: <count>/<second|minute|hour|day>
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PUBLIC_WRITE=20/hour
# Shared limiter storage for several instances, e.g. redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://

MAX_UPLOAD_MB=5

# Website cache refresh after admin edits (same secret as REVALIDATE_SECRET in the frontend)
REVALIDATE_URL=https://alldriveph.com/api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Used by `npm run seed` to create the first admin
FIRST_ADMIN_EMAIL=admin@alldriveph.com
FIRST_ADMIN_PASSWORD=change-this-strong-password
FIRST_ADMIN_NAME=Alldrive Admin

# Customer emails when a booking is confirmed or cancelled (Gmail by default).
# SMTP_USER is your Gmail address; SMTP_PASSWORD is a 16 character Gmail *app password*
# (Google Account > Security > 2-Step Verification on > App passwords), not your normal password.
# Leave them empty to skip emails; the admin booking window then says "not set up".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, defaults to "Alldrive Rent a Car PH <SMTP_USER>"
MAIL_FROM=
# Public website, used for the "View my booking" link in emails
SITE_URL=https://alldriveph.com
BUSINESS_PHONE=0946 126 0177

# Share of each completed booking a branch owner pays Alldrive (0.1 = 10%). Existing commissions keep their rate.
COMMISSION_RATE=0.1
